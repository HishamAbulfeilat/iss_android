From: ISS Android Bionic
Subject: [PATCH] Identify FSR3 shared-resource creation failures

diff --git a/src/ffx_vk_fsr3_portable.cpp b/src/ffx_vk_fsr3_portable.cpp
--- a/src/ffx_vk_fsr3_portable.cpp
+++ b/src/ffx_vk_fsr3_portable.cpp
@@ -507,7 +507,13 @@ extern "C" FfxVkPortableResult ffxVkPortableUpscaleContextCreate(
     FfxFsr3UpscalerSharedResourceDescriptions shared{};
     ffxResult = ffxFsr3UpscalerGetSharedResourceDescriptions(&result->ffxContext, &shared);
     FfxVkPortableResult createResult = fromFfxResult(ffxResult);
+    if (createResult != FFX_VK_PORTABLE_OK) {
+        std::printf("FSR3 ISS BACKEND stage=ffxFsr3UpscalerGetSharedResourceDescriptions ffx_error=%u portable_error=%d\n",
+                    static_cast<unsigned>(ffxResult), static_cast<int>(createResult));
+        std::fflush(stdout);
+    }
     if (createResult == FFX_VK_PORTABLE_OK) {
         createResult = createOwnedImage(
             *deviceInfo, shared.dilatedDepth, L"portable FSR3 dilated depth",
