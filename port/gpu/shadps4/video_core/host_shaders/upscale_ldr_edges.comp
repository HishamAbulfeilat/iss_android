// Optional inFAMOUS Android LDR UI-edge history reduction for FSR 3.1.
// No sharpening, upscaling, depth or motion-vector modification.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D scene;
layout(binding = 1, r8) uniform writeonly image2D mask;

float y(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = textureSize(scene, 0);
    if (any(greaterThanEqual(p, dim))) return;
    float c = y(texelFetch(scene, p, 0).rgb);
    float n = 0.25 * (
        y(texelFetch(scene, clamp(p + ivec2(-1, 0), ivec2(0), dim - 1), 0).rgb) +
        y(texelFetch(scene, clamp(p + ivec2( 1, 0), ivec2(0), dim - 1), 0).rgb) +
        y(texelFetch(scene, clamp(p + ivec2(0, -1), ivec2(0), dim - 1), 0).rgb) +
        y(texelFetch(scene, clamp(p + ivec2(0,  1), ivec2(0), dim - 1), 0).rgb));
    float contrast = max(c - n, 0.0) / max(c, 0.1);
    // Only thin bright marks; mask <=0.55 preserves scene history.
    float reaction = c > 0.68 ? clamp((contrast - 0.28) * 1.2, 0.0, 0.55) : 0.0;
    imageStore(mask, p, vec4(reaction, 0.0, 0.0, 0.0));
}
